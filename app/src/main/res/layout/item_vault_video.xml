<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/max_dark_bg"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardVaultThumbnail"
        android:layout_width="140dp"
        android:layout_height="80dp"
        app:cardCornerRadius="8dp"
        app:cardBackgroundColor="@color/max_card_bg"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/imgVaultThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="#222222"
            android:src="@android:drawable/ic_secure"
            app:tint="@color/max_gold"
            android:padding="20dp" />
    </androidx.cardview.widget.CardView>

    <ImageView
        android:id="@+id/btnRestore"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:padding="6dp"
        android:src="@android:drawable/ic_menu_upload"
        app:tint="@color/max_cyan"
        android:background="@drawable/circle_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_toEndOf="@id/cardVaultThumbnail"
        android:layout_toStartOf="@id/btnRestore"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tvVaultTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Locked Video" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/max_gray"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:text="Encrypted &amp; Secured" />
    </LinearLayout>
</RelativeLayout>
