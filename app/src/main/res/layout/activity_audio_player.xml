<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootAudioPlayer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A10">

    <!-- Top Header Bar: Back Button + Song Info + Equalizer + 3-Dots Menu -->
    <LinearLayout
        android:id="@+id/topAudioBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <ImageView
            android:id="@+id/btnAudioBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_bg"
            android:padding="9dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAudioPlayerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="Playing Track"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAudioPlayerArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="Unknown Artist"
                android:textColor="#00FFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnAudioTopEqualizer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/circle_bg"
            android:padding="9dp"
            android:src="@android:drawable/ic_menu_preferences"
            app:tint="#00FFFF" />

        <ImageView
            android:id="@+id/btnAudioTopMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_bg"
            android:padding="9dp"
            android:src="@android:drawable/ic_menu_more"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Center Swipeable Container: Vinyl Disc + Tonearm OR Square Box OR Lyrics Page -->
    <FrameLayout
        android:id="@+id/centerStageContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/llFlatPageIndicators"
        android:layout_below="@id/topAudioBar">

        <!-- Page 1: Vinyl Disc & Tonearm / Square Album Art -->
        <FrameLayout
            android:id="@+id/pageVinylAndArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Rotating Vinyl Disc Container -->
            <FrameLayout
                android:id="@+id/layoutVinylMode"
                android:layout_width="290dp"
                android:layout_height="290dp"
                android:layout_gravity="center">

                <!-- Outer Vinyl Grooves Circle -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardVinylOuterDisc"
                    android:layout_width="256dp"
                    android:layout_height="256dp"
                    android:layout_gravity="center"
                    app:cardBackgroundColor="#181824"
                    app:cardCornerRadius="128dp"
                    app:cardElevation="12dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <androidx.cardview.widget.CardView
                            android:layout_width="174dp"
                            android:layout_height="174dp"
                            android:layout_gravity="center"
                            app:cardBackgroundColor="#242436"
                            app:cardCornerRadius="87dp"
                            app:cardElevation="0dp">

                            <ImageView
                                android:id="@+id/imgVinylCenterArt"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@android:drawable/ic_lock_silent_mode_off" />
                        </androidx.cardview.widget.CardView>

                        <!-- Vinyl Center Spindle Hole -->
                        <View
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:background="@drawable/circle_bg" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <!-- Moving Stylus Tonearm -->
                <ImageView
                    android:id="@+id/imgVinylTonearm"
                    android:layout_width="96dp"
                    android:layout_height="130dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="10dp"
                    android:pivotX="72dp"
                    android:pivotY="14dp"
                    android:rotation="-24" />
            </FrameLayout>

            <!-- Alternative Square Album Art Box -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSquareArtBox"
                android:layout_width="248dp"
                android:layout_height="248dp"
                android:layout_gravity="center"
                android:visibility="gone"
                app:cardBackgroundColor="#1C1C2C"
                app:cardCornerRadius="24dp"
                app:cardElevation="12dp">

                <ImageView
                    android:id="@+id/imgSquareArt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_lock_silent_mode_off" />
            </androidx.cardview.widget.CardView>
        </FrameLayout>

        <!-- Page 2: Swipeable Lyrics Page -->
        <LinearLayout
            android:id="@+id/pageLyricsContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:visibility="gone">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/tvAudioLyricsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingExtra="6dp"
                    android:paddingVertical="20dp"
                    android:text="Loading Lyrics..."
                    android:textColor="#FFFFFF"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />
            </ScrollView>

            <TextView
                android:id="@+id/btnSearchLyricsOnline"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/circle_bg"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="Search Lyrics Online"
                android:textColor="#00FFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Two Flat Dash Indicators (— —) for Vinyl Page vs Lyrics Page -->
    <LinearLayout
        android:id="@+id/llFlatPageIndicators"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_above="@+id/bottomAudioControlsSection"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:id="@+id/viewDashIndicatorLeft"
            android:layout_width="22dp"
            android:layout_height="3.5dp"
            android:layout_marginEnd="6dp"
            android:background="#00FFFF" />

        <View
            android:id="@+id/viewDashIndicatorRight"
            android:layout_width="22dp"
            android:layout_height="3.5dp"
            android:layout_marginStart="6dp"
            android:background="#44FFFFFF" />
    </LinearLayout>

    <!-- Bottom Timeline & Playback Controls Section -->
    <LinearLayout
        android:id="@+id/bottomAudioControlsSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="6dp"
        android:paddingBottom="22dp">

        <!-- Secondary Feature Row: Pocket Shake Badge + Speed + Sleep Timer + Loop Mode -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnAudioPocketShake"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/circle_bg"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="Shake: OFF"
                android:textColor="#B0B0C0"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnAudioSpeed"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/circle_bg"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="1.0x"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnAudioSleepTimer"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/circle_bg"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="Timer"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnAudioLoopToggle"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/circle_bg"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="Loop All"
                android:textColor="#00FFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Straight Timeline SeekBar Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAudioCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekBarAudio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:max="100"
                android:progressTint="#00FFFF"
                android:thumbTint="#00FFFF" />

            <TextView
                android:id="@+id/tvAudioTotalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#B0B0C0"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Main Bottom Playback Row: Left Favorite (♥) | Prev | Play/Pause | Next | Right Queue -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Bottom Left Corner: Favorite Heart/Star Button -->
            <ImageView
                android:id="@+id/btnAudioFavoriteCorner"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/circle_bg"
                android:padding="9dp"
                android:src="@android:drawable/btn_star_big_off" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnAudioPrev"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/circle_bg"
                android:padding="10dp"
                app:srcCompat="@android:drawable/ic_media_previous"
                app:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/btnAudioPlayPause"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_marginHorizontal="18dp"
                android:background="@drawable/circle_bg"
                android:padding="14dp"
                app:srcCompat="@android:drawable/ic_media_pause"
                app:tint="#00FFFF" />

            <ImageView
                android:id="@+id/btnAudioNext"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/circle_bg"
                android:padding="10dp"
                app:srcCompat="@android:drawable/ic_media_next"
                app:tint="#FFFFFF" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Bottom Right Corner: Sliding Playing Queue Button -->
            <ImageView
                android:id="@+id/btnAudioQueueCorner"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/circle_bg"
                android:padding="9dp" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
