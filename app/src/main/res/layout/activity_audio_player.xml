<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootAudioPlayerFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A10"
    android:keepScreenOn="true">

    <!-- MAIN VERTICAL PLAYER LAYOUT -->
    <RelativeLayout
        android:id="@+id/layoutMainAudioContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="18dp">

        <!-- TOP BAR: Minimize Arrow, Song Title & Artist, Live Timer Pill, Share Icon -->
        <LinearLayout
            android:id="@+id/topBarAudio"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_alignParentTop="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnAudioMinimize"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle_bg"
                android:padding="10dp"
                android:src="@android:drawable/arrow_down_float"
                app:tint="#FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAudioPlayerTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:text="Song Title"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAudioPlayerArtist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Unknown"
                    android:textColor="#9999AA"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnAudioShareTop"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle_bg"
                android:padding="9dp"
                android:src="@android:drawable/ic_menu_share"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <!-- STATUS BADGES ROW: Live Countdown Timer & Shake Sensor Status -->
        <LinearLayout
            android:id="@+id/llStatusBadgesRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/topBarAudio"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvLiveTimerCountdown"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginEnd="8dp"
                android:background="#1A00FFFF"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Timer: 00:00"
                android:textColor="#00FFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvShakeModeBadge"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:background="#18FFFFFF"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="2x Shake: ON"
                android:textColor="#00FFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- CENTER STAGE: Vinyl Disc / Album Box + Tonearm + Slide-Out Drawer Handle -->
        <FrameLayout
            android:id="@+id/flCenterVinylStage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/llMiddleFeaturesRow"
            android:layout_below="@id/llStatusBadgesRow"
            android:layout_marginVertical="8dp">

            <!-- Rotating Vinyl / Swipable Album Art Container -->
            <LinearLayout
                android:id="@+id/llCenterArtContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <!-- Tonearm Bar Indicator -->
                <ImageView
                    android:id="@+id/imgVinylTonearm"
                    android:layout_width="120dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="42dp"
                    android:layout_marginBottom="-10dp"
                    android:elevation="6dp" />

                <!-- Outer Vinyl Disc / Album Art Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardCenterVinylDisc"
                    android:layout_width="250dp"
                    android:layout_height="250dp"
                    app:cardBackgroundColor="#141420"
                    app:cardCornerRadius="125dp"
                    app:cardElevation="12dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/imgVinylSurface"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop" />

                        <androidx.cardview.widget.CardView
                            android:layout_width="112dp"
                            android:layout_height="112dp"
                            android:layout_gravity="center"
                            app:cardBackgroundColor="#242436"
                            app:cardCornerRadius="56dp"
                            app:cardElevation="0dp">

                            <ImageView
                                android:id="@+id/imgCenterMusicNote"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="28dp"
                                android:src="@android:drawable/ic_lock_silent_mode_off"
                                app:tint="#00FFFF" />
                        </androidx.cardview.widget.CardView>
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tvSwipeHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Swipe up/down for Volume • Swipe left from edge for Songs"
                    android:textColor="#666677"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- RIGHT EDGE SLIDE-OUT HANDLE TAB (Pull/Tap to slide out Song Drawer Box) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSlideOutTabHandle"
                android:layout_width="34dp"
                android:layout_height="92dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="-6dp"
                app:cardBackgroundColor="#1E1E30"
                app:cardCornerRadius="14dp"
                app:cardElevation="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@android:drawable/ic_media_previous"
                        app:tint="#00FFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="S\nO\nN\nG\nS"
                        android:textColor="#FFFFFF"
                        android:textSize="8sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </FrameLayout>

        <!-- MIDDLE ACTION BAR: Equalizer, A-B Repeat, Speed/Timer, Favorite Heart, Far-Right 3-Dots -->
        <LinearLayout
            android:id="@+id/llMiddleFeaturesRow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_above="@id/llWaveformSeekSection"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:weightSum="5">

            <LinearLayout
                android:id="@+id/btnAudioEqualizer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgBtnEqualizer"
                    android:layout_width="26dp"
                    android:layout_height="26dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnAudioAbRepeat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBtnAbRepeat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A⇄B"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnAudioTimerAndSpeed"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgBtnTimerGauge"
                    android:layout_width="26dp"
                    android:layout_height="26dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnAudioFavorite"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgBtnFavoriteHeart"
                    android:layout_width="26dp"
                    android:layout_height="26dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnAudioFarRightDots"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgBtnMoreDots"
                    android:layout_width="26dp"
                    android:layout_height="26dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- STRAIGHT WAVEFORM SEEKBAR SECTION (Matches Red-Circled Screenshot 8) -->
        <LinearLayout
            android:id="@+id/llWaveformSeekSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/llMainPlaybackRow"
            android:layout_marginBottom="14dp"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tvAudioCurrentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="0:00"
                    android:textColor="#CCCCCC"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAudioTotalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="0:00"
                    android:textColor="#CCCCCC"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Custom Straight Waveform Interactive Bar -->
            <ImageView
                android:id="@+id/imgStraightWaveformBar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android: contentDescription="Waveform SeekBar" />
        </LinearLayout>

        <!-- MAIN PLAYBACK CONTROLS: Shuffle, Previous, Play/Pause Circle, Next, Repeat -->
        <LinearLayout
            android:id="@+id/llMainPlaybackRow"
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:layout_above="@id/llBottomLyricsQueueRow"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:weightSum="5">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/btnAudioShuffle"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:padding="7dp" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/btnAudioPrev"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="center"
                    android:padding="8dp" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/btnAudioPlayPause"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:padding="14dp" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/btnAudioNext"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="center"
                    android:padding="8dp" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/btnAudioRepeat"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:padding="7dp" />
            </FrameLayout>
        </LinearLayout>

        <!-- BOTTOM ROW: Lyrics & Playing Queue -->
        <RelativeLayout
            android:id="@+id/llBottomLyricsQueueRow"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_alignParentBottom="true"
            android:paddingHorizontal="8dp">

            <LinearLayout
                android:id="@+id/btnAudioLyrics"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <ImageView
                    android:id="@+id/imgLyricsIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Lyrics"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnAudioPlayingQueue"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <ImageView
                    android:id="@+id/imgQueueIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp" />

                <TextView
                    android:id="@+id/tvPlayingQueueCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Playing Queue"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </RelativeLayout>

    </RelativeLayout>

    <!-- SLIDE-OUT SONG DRAWER BOX (Slide from Right or Tap Handle/Queue to pick songs) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardSlideSongDrawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginVertical="48dp"
        android:layout_marginEnd="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="#F212121E"
        app:cardCornerRadius="22dp"
        app:cardElevation="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/tvDrawerHeaderTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Quick Song Box (0)"
                    android:textColor="#00FFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnCloseSongDrawer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#26FFFFFF"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="HIDE ✕"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="8dp"
                android:background="#22FFFFFF" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSlideDrawerSongs"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- TOP CAMERA VOLUME NOTIFICATION HUD (Matches Screenshot 9: 80% + Bar with 4 Dots) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardTopVolumeHud"
        android:layout_width="290dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="#F5050508"
        app:cardCornerRadius="22dp"
        app:cardElevation="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="14dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgTopVolumeSpeaker"
                    android:layout_width="26dp"
                    android:layout_height="26dp" />

                <TextView
                    android:id="@+id/tvTopVolumePercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="80%"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Custom Progress Bar + 4 Trailing Dots (Matches Screenshot 9) -->
            <ImageView
                android:id="@+id/imgTopVolumeBarWithDots"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="10dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</FrameLayout>
