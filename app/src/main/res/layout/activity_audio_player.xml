<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A10"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnAudioBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="NOW PLAYING"
            android:textColor="#00FFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnAudioEqualizer"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_preferences"
            app:tint="#00FFFF" />
    </LinearLayout>

    <!-- Center Vinyl / Album Art Card -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.cardview.widget.CardView
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="center"
            app:cardBackgroundColor="#15151E"
            app:cardCornerRadius="120dp"
            app:cardElevation="12dp">

            <ImageView
                android:id="@+id/imgCenterDisc"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_lock_silent_mode_off"
                app:tint="#00FFFF" />
        </androidx.cardview.widget.CardView>
    </FrameLayout>

    <!-- Song Title & Artist Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="12dp">

        <TextView
            android:id="@+id/tvCurrentAudioTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:gravity="center"
            android:singleLine="true"
            android:text="Song Title"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCurrentAudioArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:maxLines="1"
            android:text="MAX Audio"
            android:textColor="#888888"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Extra Tools Row: Favorite, Speed, Sleep Timer, Share -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginVertical="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="4">

        <ImageView
            android:id="@+id/btnAudioFavorite"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:padding="6dp"
            android:src="@android:drawable/btn_star_big_off"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/btnAudioSpeed"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="1.0x"
            android:textColor="#00FFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnAudioTimer"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Timer"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/btnAudioShare"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_share"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- SeekBar & Timestamps -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvAudioCurrentPos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#AAAAAA"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seekBarAudio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:progressTint="#00FFFF"
            android:thumbTint="#FFFFFF" />

        <TextView
            android:id="@+id/tvAudioTotalDur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#AAAAAA"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Main Playback Controls: Shuffle, Prev, Play/Pause, Next, Repeat -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="5">

        <TextView
            android:id="@+id/btnAudioShuffle"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="SHUFFLE"
            android:textColor="#888888"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnAudioPrev"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:padding="8dp"
            android:src="@android:drawable/ic_media_previous"
            app:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/btnAudioPlayPause"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/circle_bg"
            android:padding="14dp"
            android:src="@android:drawable/ic_media_pause"
            app:tint="#00FFFF" />

        <ImageView
            android:id="@+id/btnAudioNext"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:padding="8dp"
            android:src="@android:drawable/ic_media_next"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/btnAudioRepeat"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="LOOP ALL"
            android:textColor="#00FFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
