<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootAudioPlayerFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A10"
    android:keepScreenOn="true">

    <!-- Optional Custom Theme Wallpaper Background -->
    <ImageView
        android:id="@+id/imgAudioThemeWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:id="@+id/viewAudioThemeDimmer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B80A0A10"
        android:visibility="gone" />

    <!-- MAIN VERTICAL PLAYER LAYOUT -->
    <RelativeLayout
        android:id="@+id/layoutMainAudioContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="18dp">

        <!-- TOP BAR: Minimize Arrow, Song Title & Singer Name, Share Icon -->
        <LinearLayout
            android:id="@+id/topBarAudio"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_alignParentTop="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnAudioMinimize"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle_bg"
                android:padding="10dp"
                android:src="@android:drawable/arrow_down_float"
                app:tint="#FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAudioPlayerTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:text="Song Title"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAudioPlayerArtist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Unknown Singer"
                    android:textColor="#D0D0E0"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnAudioShareTop"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle_bg"
                android:padding="9dp"
                android:src="@android:drawable/ic_menu_share"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <!-- LIVE MILLISECOND SLEEP TIMER ROW -->
        <LinearLayout
            android:id="@+id/llStatusBadgesRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/topBarAudio"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvLiveTimerCountdown"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="#2600FFFF"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="30:00.00"
                android:textColor="#00FFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- CENTER STAGE: Default Rotating Disc with Moving Tonearm + Song Photo OR Square Box with Swipe Lyrics -->
        <FrameLayout
            android:id="@+id/flCenterVinylStage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/llMiddleFeaturesRow"
            android:layout_below="@id/llStatusBadgesRow"
            android:layout_marginVertical="6dp">

            <!-- Art / Disc View Container -->
            <LinearLayout
                android:id="@+id/llCenterArtContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <!-- Moving Tonearm ("Danda") Indicator above the Disc -->
                <ImageView
                    android:id="@+id/imgVinylTonearm"
                    android:layout_width="126dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="40dp"
                    android:layout_marginBottom="-10dp"
                    android:elevation="8dp" />

                <!-- Outer Vinyl Disc / Square Album Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardCenterVinylDisc"
                    android:layout_width="252dp"
                    android:layout_height="252dp"
                    app:cardBackgroundColor="#141422"
                    app:cardCornerRadius="126dp"
                    app:cardElevation="14dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <!-- Full Square / Background Photo -->
                        <ImageView
                            android:id="@+id/imgSquareFullArt"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />

                        <!-- Vinyl Grooves Ring -->
                        <ImageView
                            android:id="@+id/imgVinylSurface"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop" />

                        <!-- Inner Center Circle with Song Photo -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardInnerDiscPhoto"
                            android:layout_width="124dp"
                            android:layout_height="124dp"
                            android:layout_gravity="center"
                            app:cardBackgroundColor="#242438"
                            app:cardCornerRadius="62dp"
                            app:cardElevation="0dp">

                            <ImageView
                                android:id="@+id/imgCenterMusicNote"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@android:drawable/ic_lock_silent_mode_off" />
                        </androidx.cardview.widget.CardView>
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <!-- 2 Flat Pager Dots below Square Album Box (Art | Lyrics) -->
                <LinearLayout
                    android:id="@+id/llSquarePagerDots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <View
                        android:id="@+id/dotFlatPageArt"
                        android:layout_width="22dp"
                        android:layout_height="4dp"
                        android:layout_marginEnd="6dp"
                        android:background="#00FFFF" />

                    <View
                        android:id="@+id/dotFlatPageLyrics"
                        android:layout_width="22dp"
                        android:layout_height="4dp"
                        android:background="#44FFFFFF" />
                </LinearLayout>
            </LinearLayout>

            <!-- Inline Swipeable Lyrics Panel (Shown when swiping right-to-left on Square Box) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardInlineLyricsStage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="8dp"
                android:layout_marginVertical="8dp"
                android:visibility="gone"
                app:cardBackgroundColor="#CC141422"
                app:cardCornerRadius="22dp"
                app:cardElevation="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Synced Lyrics"
                            android:textColor="#00FFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnFindLyricsOnline"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginEnd="8dp"
                            android:background="#2600FFFF"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:text="Find Online"
                            android:textColor="#00FFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnEditLyricsInline"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:background="#22FFFFFF"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:text="Edit"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="10dp"
                        android:layout_weight="1">

                        <TextView
                            android:id="@+id/tvInlineLyricsContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:lineSpacingExtra="6dp"
                            android:paddingVertical="12dp"
                            android:text="Swipe right to return to Album Art.\nTap 'Find Online' to search lyrics."
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </ScrollView>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="22dp"
                            android:layout_height="4dp"
                            android:layout_marginEnd="6dp"
                            android:background="#44FFFFFF" />

                        <View
                            android:layout_width="22dp"
                            android:layout_height="4dp"
                            android:background="#00FFFF" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- RIGHT EDGE SLIDE-OUT HANDLE TAB -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSlideOutTabHandle"
                android:layout_width="26dp"
                android:layout_height="68dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="-6dp"
                app:cardBackgroundColor="#242438"
                app:cardCornerRadius="13dp"
                app:cardElevation="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imgSlideHandleArrow"
                        android:layout_width="16dp"
                        android:layout_height="16dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </FrameLayout>

        <!-- MIDDLE ACTION BAR: 4 Reorderable Slots (Equalizer, A-B, Timer, Pocket Shake) + Fixed Far-Right 3-Dots -->
        <LinearLayout
            android:id="@+id/llMiddleFeaturesRow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_above="@id/llWaveformSeekSection"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/llReorderableMiddleSlots"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="4"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:weightSum="4">

                <LinearLayout
                    android:id="@+id/btnAudioEqualizer"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imgBtnEqualizer"
                        android:layout_width="26dp"
                        android:layout_height="26dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnAudioAbRepeat"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvBtnAbRepeat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="A⇄B"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnAudioTimerAndSpeed"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imgBtnTimerGauge"
                        android:layout_width="26dp"
                        android:layout_height="26dp" />
                </LinearLayout>

                <!-- Pocket Shake Option placed where Like/Heart used to be (Default OFF) -->
                <LinearLayout
                    android:id="@+id/btnAudioPocketShake"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imgBtnPocketShake"
                        android:layout_width="26dp"
                        android:layout_height="26dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Fixed Far-Right 3-Dots Button -->
            <LinearLayout
                android:id="@+id/btnAudioFarRightDots"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgBtnMoreDots"
                    android:layout_width="26dp"
                    android:layout_height="26dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- STRAIGHT WAVEFORM / SIMPLE LINE SEEKBAR SECTION -->
        <LinearLayout
            android:id="@+id/llWaveformSeekSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/llMainPlaybackRow"
            android:layout_marginBottom="14dp"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tvAudioCurrentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="0:00"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAudioTotalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="0:00"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <ImageView
                android:id="@+id/imgStraightWaveformBar"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:contentDescription="Waveform SeekBar" />
        </LinearLayout>

        <!-- MAIN PLAYBACK CONTROLS: Shuffle, Previous, Play/Pause Circle, Next, Repeat -->
        <LinearLayout
            android:id="@+id/llMainPlaybackRow"
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:layout_above="@id/llBottomLyricsQueueRow"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:weightSum="5">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/btnAudioShuffle"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:padding="7dp" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/btnAudioPrev"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="center"
                    android:padding="8dp" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/btnAudioPlayPause"
                    android:layout_width="66dp"
                    android:layout_height="66dp"
                    android:layout_gravity="center"
                    android:padding="12dp" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/btnAudioNext"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="center"
                    android:padding="8dp" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/btnAudioRepeat"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:padding="7dp" />
            </FrameLayout>
        </LinearLayout>

        <!-- BOTTOM ROW: Add to Favorite (Moved to Bottom-Left) & Playing Queue (Bottom-Right) -->
        <RelativeLayout
            android:id="@+id/llBottomLyricsQueueRow"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_alignParentBottom="true"
            android:paddingHorizontal="8dp">

            <LinearLayout
                android:id="@+id/btnAudioFavoriteBottom"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <ImageView
                    android:id="@+id/imgBtnFavoriteHeart"
                    android:layout_width="22dp"
                    android:layout_height="22dp" />

                <TextView
                    android:id="@+id/tvBottomFavoriteLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Add to Favorite"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnAudioPlayingQueue"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <ImageView
                    android:id="@+id/imgQueueIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp" />

                <TextView
                    android:id="@+id/tvPlayingQueueCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Playing Queue (0/0)"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </RelativeLayout>

    </RelativeLayout>

    <!-- OUTSIDE TOUCH DISMISS SCRIM FOR PLAYING QUEUE -->
    <View
        android:id="@+id/viewQueueOutsideScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <!-- SLIDE-OUT PLAYING QUEUE DRAWER (Slides Right-to-Left, Shows 10-11 Songs + Singer Name) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardSlideSongDrawer"
        android:layout_width="312dp"
        android:layout_height="530dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="#F712121E"
        app:cardCornerRadius="22dp"
        app:cardElevation="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/tvDrawerHeaderTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Playing Queue (1/10)"
                    android:textColor="#00FFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnCloseSongDrawer"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/circle_bg"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="#FF4081"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="6dp"
                android:background="#26FFFFFF" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSlideDrawerSongs"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- TOP CAMERA VOLUME NOTIFICATION HUD -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardTopVolumeHud"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="#F510101A"
        app:cardCornerRadius="22dp"
        app:cardElevation="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="14dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgTopVolumeSpeaker"
                    android:layout_width="26dp"
                    android:layout_height="26dp" />

                <TextView
                    android:id="@+id/tvTopVolumePercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="80%"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/imgTopVolumeBarWithDots"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginTop="10dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</FrameLayout>
