<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootAudioPlayer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08080E">

    <!-- Top Header Bar: Down Button + Marquee Song Title & Artist + Share Icon -->
    <LinearLayout
        android:id="@+id/topAudioBar"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <ImageView
            android:id="@+id/btnAudioBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/circle_bg"
            android:padding="9dp"
            android:src="@android:drawable/arrow_down_float"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAudioPlayerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:text="Playing Track"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAudioPlayerArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="Unknown Artist"
                android:textColor="#9999AA"
                android:textSize="12.5sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnAudioShareTop"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/circle_bg"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_share"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Center Stage: Vinyl Disc + Tonearm OR Square Album Box OR Swipe Lyrics -->
    <FrameLayout
        android:id="@+id/centerStageContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/llFlatPageIndicators"
        android:layout_below="@id/topAudioBar">

        <!-- Page 1: Vinyl Disc with Tonearm OR Square Art Box -->
        <FrameLayout
            android:id="@+id/pageVinylAndArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Default Rotating Vinyl Disc + Top White Stylus Tonearm -->
            <FrameLayout
                android:id="@+id/layoutVinylMode"
                android:layout_width="300dp"
                android:layout_height="320dp"
                android:layout_gravity="center">

                <!-- Rotating Dark Vinyl Platter -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardVinylOuterDisc"
                    android:layout_width="256dp"
                    android:layout_height="256dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="#161622"
                    app:cardCornerRadius="128dp"
                    app:cardElevation="10dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/imgVinylGrooves"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <androidx.cardview.widget.CardView
                            android:layout_width="136dp"
                            android:layout_height="136dp"
                            android:layout_gravity="center"
                            app:cardBackgroundColor="#222234"
                            app:cardCornerRadius="68dp"
                            app:cardElevation="0dp">

                            <ImageView
                                android:id="@+id/imgVinylCenterArt"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@android:drawable/ic_lock_silent_mode_off" />
                        </androidx.cardview.widget.CardView>
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <!-- Top Moving White Tonearm (Danda) -->
                <ImageView
                    android:id="@+id/imgVinylTonearm"
                    android:layout_width="150dp"
                    android:layout_height="70dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="4dp"
                    android:rotation="-14"
                    android:transformPivotX="18dp"
                    android:transformPivotY="18dp" />
            </FrameLayout>

            <!-- Alternative Square Album Art Box -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSquareArtBox"
                android:layout_width="252dp"
                android:layout_height="252dp"
                android:layout_gravity="center"
                android:visibility="gone"
                app:cardBackgroundColor="#1A1A28"
                app:cardCornerRadius="22dp"
                app:cardElevation="12dp">

                <ImageView
                    android:id="@+id/imgSquareArt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_lock_silent_mode_off" />
            </androidx.cardview.widget.CardView>

            <!-- Right-Edge Pull Tab (<) for Sliding Queue -->
            <TextView
                android:id="@+id/btnSideQueueTab"
                android:layout_width="26dp"
                android:layout_height="64dp"
                android:layout_gravity="end|center_vertical"
                android:background="#28283C"
                android:gravity="center"
                android:text="&lt;"
                android:textColor="#00FFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Page 2: Swipeable Lyrics Page with Online Lookup & Add to Favorite Below Lyrics -->
        <LinearLayout
            android:id="@+id/pageLyricsContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingVertical="10dp"
            android:visibility="gone">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/tvAudioLyricsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingExtra="6dp"
                    android:paddingVertical="18dp"
                    android:text="Loading Lyrics..."
                    android:textColor="#FFFFFF"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnLyricsAddToFavorite"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/circle_bg"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="♡  Add to Favorite"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnSearchLyricsOnline"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/circle_bg"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Find Lyrics Online"
                    android:textColor="#00FFFF"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Two Flat Dash Indicators (— —) for Vinyl/Square Page vs Lyrics Page -->
    <LinearLayout
        android:id="@+id/llFlatPageIndicators"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_above="@+id/bottomAudioControlsSection"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:id="@+id/viewDashIndicatorLeft"
            android:layout_width="22dp"
            android:layout_height="3.5dp"
            android:layout_marginEnd="5dp"
            android:background="#00FFFF" />

        <View
            android:id="@+id/viewDashIndicatorRight"
            android:layout_width="22dp"
            android:layout_height="3.5dp"
            android:layout_marginStart="5dp"
            android:background="#44FFFFFF" />
    </LinearLayout>

    <!-- Bottom Controls Section (Matches Screenshot 1 Layout) -->
    <LinearLayout
        android:id="@+id/bottomAudioControlsSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="6dp"
        android:paddingBottom="18dp">

        <!-- 5-Icon Tool Row: 4 Rearrangeable Slots (Equalizer | A-B | Speed | Timer) + 3-Dots Menu -->
        <LinearLayout
            android:id="@+id/rowCustomizableTools"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:weightSum="5">

            <TextView
                android:id="@+id/btnToolSlot1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="ttt"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnToolSlot2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="A⇌B"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnToolSlot3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="1.0x"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnToolSlot4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Timer"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/btnAudioThreeDots"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:padding="6dp"
                    android:src="@android:drawable/ic_menu_more"
                    app:tint="#FFFFFF" />
            </FrameLayout>
        </LinearLayout>

        <!-- Time Labels Row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvAudioCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="0:00"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAudioTotalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="0:00"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Waveform Bar OR Simple Straight SeekBar Container -->
        <FrameLayout
            android:id="@+id/frameScrubberContainer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp">

            <SeekBar
                android:id="@+id/seekBarAudioStraight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:max="1000"
                android:progressTint="#00FFFF"
                android:thumbTint="#00FFFF"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Transport Controls Row: Shuffle | Prev | Cyan Ring Play/Pause | Next | Loop -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:weightSum="5">

            <TextView
                android:id="@+id/btnAudioShuffle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🔀"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnAudioPrev"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:padding="8dp"
                app:srcCompat="@android:drawable/ic_media_previous"
                app:tint="#FFFFFF" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/btnAudioPlayPause"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_gravity="center"
                    android:padding="13dp"
                    app:srcCompat="@android:drawable/ic_media_pause"
                    app:tint="#FFFFFF" />
            </FrameLayout>

            <ImageView
                android:id="@+id/btnAudioNext"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:padding="8dp"
                app:srcCompat="@android:drawable/ic_media_next"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/btnAudioLoopMode"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🔁"
                android:textColor="#00FFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bottom Bar: Left = Pocket Shake (Default OFF) | Right = Playing Queue (X/Y) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBottomLeftPocketShake"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:paddingStart="6dp"
                android:text="📳  Pocket Shake: OFF"
                android:textColor="#B0B0C0"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnBottomRightPlayingQueue"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="end|center_vertical"
                android:paddingEnd="6dp"
                android:text="≡  Playing Queue (1/1)"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Outside Scrim: Tapping anywhere on display closes the Playing Queue -->
    <View
        android:id="@+id/scrimQueueOutside"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone" />

    <!-- Right-to-Left Sliding Playing Queue Drawer (Shows 10-11 Songs + Singer Name + Top Close X) -->
    <LinearLayout
        android:id="@+id/drawerPlayingQueueRight"
        android:layout_width="308dp"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:background="#F512121E"
        android:clickable="true"
        android:elevation="24dp"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="14dp"
        android:visibility="gone">

        <!-- Queue Header: Playing Queue (Current/Total) + Prominent Close (✕) Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDrawerQueueHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Playing Queue (1/1)"
                android:textColor="#00FFFF"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCloseQueueDrawer"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/circle_bg"
                android:gravity="center"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="6dp"
            android:background="#26FFFFFF" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSlidingAudioQueue"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical" />
    </LinearLayout>

</RelativeLayout>
