<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A10">

    <!-- Top Navigation Bar: Songs | Playlists | Artists | Favorites + Far-Right 3-Dots Menu -->
    <LinearLayout
        android:id="@+id/llMusicTopTabs"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/tvMusicTabSongs"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingEnd="18dp"
            android:text="Songs"
            android:textColor="#00FFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMusicTabPlaylists"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="Playlists"
            android:textColor="#888888"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMusicTabArtists"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="Artists"
            android:textColor="#888888"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMusicTabFavorites"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="Favorites"
            android:textColor="#888888"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnMusicMoreMenu"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_more"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Action Sub-Header: Shuffle All + Track Count + Create Playlist Button -->
    <LinearLayout
        android:id="@+id/llMusicQuickActionRow"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_below="@id/llMusicTopTabs"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:id="@+id/btnShufflePlayAll"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="#161624"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/ic_media_play"
                app:tint="#00FFFF" />

            <TextView
                android:id="@+id/tvShuffleAllCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Shuffle All (0)"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnNewPlaylist"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="#161624"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="+ New Playlist"
            android:textColor="#00FFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/dividerMusicTop"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/llMusicQuickActionRow"
        android:layout_marginTop="4dp"
        android:background="#14FFFFFF" />

    <!-- Main Songs / Playlists RecyclerView -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/cardMiniAudioPlayer"
        android:layout_below="@id/dividerMusicTop">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMusicTracks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp" />

        <LinearLayout
            android:id="@+id/llMusicEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@android:drawable/ic_lock_silent_mode_off"
                app:tint="#00FFFF" />

            <TextView
                android:id="@+id/tvMusicEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="No Songs Found"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMusicEmptyDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Add songs to your playlists or tap the top-right menu to refresh."
                android:textColor="#888888"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom Mini Now-Playing Bar -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardMiniAudioPlayer"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="#181828"
        app:cardCornerRadius="18dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/circle_bg"
                android:padding="8dp"
                android:src="@android:drawable/ic_lock_silent_mode_off"
                app:tint="#00FFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMiniPlayerTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Song Title"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMiniPlayerArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Tap to open full player"
                    android:textColor="#00FFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnMiniPlayOpen"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/circle_bg"
                android:padding="8dp"
                android:src="@android:drawable/ic_media_play"
                app:tint="#00FFFF" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</RelativeLayout>
