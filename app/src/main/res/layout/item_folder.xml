<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/max_dark_bg"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <ImageView
        android:id="@+id/imgFolderIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_menu_gallery"
        app:tint="@color/max_gold"
        android:background="#15151E"
        android:padding="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_toEndOf="@id/imgFolderIcon"
        android:layout_toStartOf="@id/btnFolderOptions"
        android:layout_centerVertical="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tvFolderName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Folder Name" />

        <TextView
            android:id="@+id/tvVideoCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/max_gray"
            android:textSize="13sp"
            android:layout_marginTop="2dp"
            android:text="0 Videos" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btnFolderOptions"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:src="@android:drawable/ic_menu_more"
        app:tint="@color/max_gray"
        android:padding="4dp" />
</RelativeLayout>
