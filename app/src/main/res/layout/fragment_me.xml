<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/max_dark_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:background="@color/max_card_bg"
        android:gravity="center_vertical"
        android:elevation="4dp">
        
        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@android:drawable/ic_menu_myplaces"
            android:background="@drawable/circle_bg"
            app:tint="@color/max_gold"
            android:padding="12dp" />
            
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MAX Pro User"
                android:textColor="@color/max_gold"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Premium Status: Active"
                android:textColor="@color/max_cyan"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Premium Tools"
        android:textColor="@color/max_cyan"
        android:textSize="16sp"
        android:textStyle="bold"
        android:padding="20dp" />

    <!-- NEW: Privacy Vault Button -->
    <LinearLayout
        android:id="@+id/btnPrivacyVault"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#111111"
        android:layout_marginBottom="2dp"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true">
        
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_secure"
            app:tint="@color/max_gold" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Privacy Vault (Secret Box)"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:layout_marginStart="16dp"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Settings &amp; Preferences"
        android:textColor="@color/max_cyan"
        android:textSize="16sp"
        android:textStyle="bold"
        android:padding="20dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Playback Settings"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:padding="16dp"
        android:background="#111111"
        android:layout_marginBottom="2dp"/>
        
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="About MAX Player Pro"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:padding="16dp"
        android:background="#111111" />
</LinearLayout>
