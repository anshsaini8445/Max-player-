<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootAudioFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A10">

    <LinearLayout
        android:id="@+id/topAudioFilterContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical">

        <!-- Sub-Navigation Row: Songs | Folders | Albums | Artists | Favorites -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <TextView
                    android:id="@+id/tvAudioTabSongs"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="Songs"
                    android:textColor="#00FFFF"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAudioTabFolders"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="Folders"
                    android:textColor="#FFFFFF"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAudioTabAlbums"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="Albums"
                    android:textColor="#FFFFFF"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAudioTabArtists"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="Artists"
                    android:textColor="#FFFFFF"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAudioTabPlaylists"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="Favorites"
                    android:textColor="#FFFFFF"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Action Bar: Shuffle All + Count + Bright 3-Dots Sort Menu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/btnShuffleAllAudio"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/circle_bg"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Play / Shuffle All"
                android:textColor="#00FFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAudioTotalCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="0 Songs"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnAudioSortMenu"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/circle_bg"
                android:padding="7dp"
                android:src="@android:drawable/ic_menu_more"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22FFFFFF" />
    </LinearLayout>

    <!-- Main Songs RecyclerView -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/cardBottomMiniPlayer"
        android:layout_below="@id/topAudioFilterContainer">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAudioList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp" />

        <LinearLayout
            android:id="@+id/llAudioEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:src="@android:drawable/ic_lock_silent_mode_off"
                app:tint="#00FFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="No Audio Tracks Found"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom Now-Playing Mini-Player Bar with Marquee Scrolling Title, Artist Subtitle & || Pause / Play Toggle -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardBottomMiniPlayer"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="6dp"
        android:visibility="gone"
        app:cardBackgroundColor="#181828"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <androidx.cardview.widget.CardView
                android:layout_width="46dp"
                android:layout_height="46dp"
                app:cardBackgroundColor="#242438"
                app:cardCornerRadius="23dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/imgMiniPlayerArt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_lock_silent_mode_off" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMiniPlayerTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:text="Now Playing Song"
                    android:textColor="#FFFFFF"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMiniPlayerArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Unknown Artist"
                    android:textColor="#00FFFF"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- Play (▶) / Pause (||) Button -->
            <TextView
                android:id="@+id/btnMiniPlayerPlayPause"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/circle_bg"
                android:gravity="center"
                android:text="||"
                android:textColor="#00FFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</RelativeLayout>
